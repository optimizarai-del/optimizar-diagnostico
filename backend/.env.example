# Copiar a .env y completar. El .env NO se commitea.

# --- Base de datos -------------------------------------------------------
# Local: SQLite. Producción: la connection string de Supabase.
DATABASE_URL=sqlite:///./diagnostico.db
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROYECTO.supabase.co:5432/postgres

# --- URL pública ---------------------------------------------------------
# Se usa para armar el link del diagnóstico que va en el mail y en WhatsApp.
PUBLIC_URL=http://localhost:5173

# --- Claude --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
MODELO=claude-opus-5

# --- Email (Hostinger SMTP) ---------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=diagnostico@TU-DOMINIO
SMTP_PASSWORD=
SMTP_FROM_NAME=Optimizar

# --- WhatsApp ------------------------------------------------------------
# Solo dígitos, con código de país y sin el 15. Ej: 5492954123456
WHATSAPP_NUMERO=549...

# --- Panel de métricas ---------------------------------------------------
ADMIN_API_KEY=

# --- CORS ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
